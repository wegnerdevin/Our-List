<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>Our List</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..900,0..100&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#f5efe4;
    --paper-2:#ede4d3;
    --ink:#1f1b16;
    --ink-soft:#5b5246;
    --rule:#d8cdb8;
    --accent:#c2410c;     /* burnt sienna */
    --accent-soft:#f0d5c2;
    --done:#9a8f7d;
    --shadow: 0 1px 0 rgba(31,27,22,.04), 0 8px 24px -12px rgba(31,27,22,.18);
  }
  @media (prefers-color-scheme: dark){
    :root{
      --paper:#1a1714;
      --paper-2:#221d18;
      --ink:#efe8d9;
      --ink-soft:#a99e89;
      --rule:#3a3128;
      --accent:#f4a261;
      --accent-soft:#3a2a1f;
      --done:#6b6354;
      --shadow: 0 1px 0 rgba(0,0,0,.4), 0 8px 24px -12px rgba(0,0,0,.6);
    }
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--paper);color:var(--ink)}
  body{
    font-family:"Fraunces", Georgia, serif;
    font-feature-settings:"ss01","ss02","liga";
    min-height:100dvh;
    background-image:
      radial-gradient(1200px 600px at 10% -10%, rgba(194,65,12,.07), transparent 60%),
      radial-gradient(900px 500px at 110% 110%, rgba(31,27,22,.05), transparent 60%);
  }
  .wrap{max-width:780px; margin:0 auto; padding:32px 22px 140px}
  header{
    display:flex; align-items:baseline; justify-content:space-between;
    gap:16px; margin-bottom:8px;
  }
  .brand{
    font-variation-settings:"opsz" 144, "SOFT" 30;
    font-weight:500; font-size:clamp(40px, 7vw, 64px);
    letter-spacing:-.02em; line-height:1;
  }
  .brand em{font-style:italic; color:var(--accent); font-weight:400}
  .sub{
    font-family:"JetBrains Mono", ui-monospace, monospace;
    text-transform:uppercase; letter-spacing:.18em; font-size:11px;
    color:var(--ink-soft);
  }
  .rule{height:1px; background:var(--rule); margin:18px 0 22px; position:relative}
  .rule::after{
    content:""; position:absolute; left:0; top:-3px; width:64px; height:7px;
    background:var(--accent);
  }

  /* Add form */
  form.add{
    background:var(--paper-2);
    border:1px solid var(--rule);
    border-radius:14px;
    padding:14px;
    display:grid;
    grid-template-columns: 1fr;
    gap:10px;
    box-shadow:var(--shadow);
  }
  .row{display:grid; gap:10px; grid-template-columns: 1fr 110px 150px auto}
  @media (max-width:640px){ .row{grid-template-columns: 1fr 1fr} .row .add-btn{grid-column:1/-1} }
  .field{
    display:flex; align-items:center; gap:8px;
    background:var(--paper);
    border:1px solid var(--rule);
    border-radius:10px;
    padding:10px 12px;
  }
  .field label{
    font-family:"JetBrains Mono", monospace;
    font-size:10px; letter-spacing:.16em; text-transform:uppercase;
    color:var(--ink-soft);
  }
  .field input, .field select, .field textarea{
    width:100%; border:0; background:transparent; color:var(--ink);
    font:inherit; font-size:17px; outline:none;
  }
  textarea{resize:vertical; min-height:36px; font-family:inherit}
  .add-btn{
    border:0; cursor:pointer;
    background:var(--ink); color:var(--paper);
    font-family:"JetBrains Mono", monospace; text-transform:uppercase;
    letter-spacing:.16em; font-size:12px; font-weight:500;
    padding:0 18px; border-radius:10px;
    transition:transform .15s ease, background .2s ease;
  }
  .add-btn:hover{background:var(--accent); transform:translateY(-1px)}
  .add-btn:active{transform:translateY(0)}

  /* Category filter */
  .chips{display:flex; flex-wrap:wrap; gap:6px; margin:22px 0 10px}
  .chip{
    font-family:"JetBrains Mono", monospace; font-size:11px;
    letter-spacing:.14em; text-transform:uppercase;
    padding:6px 10px; border-radius:999px;
    border:1px solid var(--rule); background:transparent; color:var(--ink-soft);
    cursor:pointer; transition:all .15s ease;
  }
  .chip:hover{color:var(--ink); border-color:var(--ink-soft)}
  .chip.active{background:var(--ink); color:var(--paper); border-color:var(--ink)}
  .chip .count{opacity:.6; margin-left:6px}

  /* List */
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin:24px 4px 8px;
  }
  .section-head h2{
    font-size:14px; font-family:"JetBrains Mono", monospace;
    text-transform:uppercase; letter-spacing:.2em; color:var(--ink-soft);
    margin:0; font-weight:500;
  }
  ul.list{list-style:none; padding:0; margin:0}
  li.item{
    display:grid;
    grid-template-columns: 28px 1fr auto;
    align-items:start; gap:14px;
    padding:16px 6px;
    border-bottom:1px solid var(--rule);
    position:relative;
  }
  li.item:last-child{border-bottom:0}
  .check{
    appearance:none; -webkit-appearance:none;
    width:22px; height:22px; border:1.5px solid var(--ink-soft);
    border-radius:50%; cursor:pointer; margin-top:4px;
    position:relative; background:transparent;
    transition: all .2s ease;
  }
  .check:hover{border-color:var(--accent)}
  .check:checked{background:var(--accent); border-color:var(--accent)}
  .check:checked::after{
    content:""; position:absolute; left:6px; top:2px;
    width:6px; height:11px; border:solid var(--paper);
    border-width:0 2px 2px 0; transform:rotate(45deg);
  }
  .item-body{min-width:0}
  .item-title{
    font-size:21px; line-height:1.25; letter-spacing:-.01em;
    font-variation-settings:"opsz" 36;
    word-wrap:break-word;
  }
  .item-meta{
    display:flex; flex-wrap:wrap; gap:10px; margin-top:4px;
    font-family:"JetBrains Mono", monospace; font-size:11px;
    letter-spacing:.1em; text-transform:uppercase; color:var(--ink-soft);
  }
  .item-meta .cat{
    background:var(--accent-soft); color:var(--accent);
    padding:2px 8px; border-radius:999px;
  }
  .item-note{
    margin-top:6px; color:var(--ink-soft);
    font-style:italic; font-size:15px; line-height:1.45;
  }
  li.item.done .item-title{color:var(--done); text-decoration:line-through; text-decoration-thickness:1px}
  li.item.done .item-note, li.item.done .item-meta{opacity:.55}

  .actions{display:flex; gap:4px; align-items:center}
  .icon-btn{
    background:transparent; border:0; cursor:pointer; padding:6px;
    color:var(--ink-soft); border-radius:6px;
    transition:all .15s ease;
  }
  .icon-btn:hover{color:var(--ink); background:var(--paper-2)}
  .icon-btn.danger:hover{color:var(--accent)}
  .icon-btn svg{display:block}

  /* Edit mode */
  .edit-form{
    grid-column:1 / -1; margin-top:8px;
    display:grid; gap:8px;
    grid-template-columns: 1fr 100px 140px;
  }
  @media (max-width:640px){ .edit-form{grid-template-columns:1fr 1fr} }
  .edit-form textarea{grid-column:1 / -1}
  .edit-actions{grid-column:1 / -1; display:flex; gap:8px; justify-content:flex-end}
  .ghost-btn{
    background:transparent; border:1px solid var(--rule);
    color:var(--ink); padding:8px 14px; border-radius:8px;
    font-family:"JetBrains Mono", monospace; font-size:11px;
    letter-spacing:.16em; text-transform:uppercase; cursor:pointer;
  }
  .ghost-btn:hover{border-color:var(--ink)}
  .ghost-btn.primary{background:var(--ink); color:var(--paper); border-color:var(--ink)}

  /* Empty + status */
  .empty{
    text-align:center; padding:60px 20px; color:var(--ink-soft);
    font-style:italic; font-size:18px;
  }
  .status{
    position:fixed; bottom:18px; left:50%; transform:translateX(-50%);
    font-family:"JetBrains Mono", monospace; font-size:11px;
    letter-spacing:.14em; text-transform:uppercase;
    background:var(--ink); color:var(--paper);
    padding:8px 14px; border-radius:999px;
    opacity:0; transition:opacity .3s ease;
    pointer-events:none;
  }
  .status.show{opacity:1}
  .conn{
    display:inline-block; width:8px; height:8px; border-radius:50%;
    background:#aaa; margin-right:8px; vertical-align:middle;
  }
  .conn.online{background:#4ade80; box-shadow:0 0 8px #4ade80}

  /* Tiny entrance animation */
  li.item{animation:fade .3s ease both}
  @keyframes fade{from{opacity:0; transform:translateY(4px)} to{opacity:1; transform:none}}

  .footer-note{
    text-align:center; margin-top:40px; color:var(--ink-soft);
    font-size:12px; font-family:"JetBrains Mono", monospace;
    letter-spacing:.14em; text-transform:uppercase;
  }
  .footer-note .clear{
    background:transparent; border:0; color:var(--ink-soft);
    text-decoration:underline; cursor:pointer; font:inherit;
    letter-spacing:inherit; text-transform:inherit;
  }
  .footer-note .clear:hover{color:var(--accent)}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">Our <em>List</em></div>
    <div class="sub"><span class="conn" id="conn"></span><span id="connText">connecting…</span></div>
  </header>
  <div class="rule"></div>

  <form class="add" id="addForm" autocomplete="off">
    <div class="row">
      <div class="field" style="grid-column:1 / -1">
        <label>Item</label>
        <input id="title" placeholder="What do we need?" required maxlength="200"/>
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label>Qty</label>
        <input id="qty" placeholder="1" maxlength="20"/>
      </div>
      <div class="field">
        <label>Category</label>
        <select id="category">
          <option>Groceries</option>
          <option>Household</option>
          <option>Pharmacy</option>
          <option>Gifts</option>
          <option>Home</option>
          <option>Clothing</option>
          <option>Tech</option>
          <option>Other</option>
        </select>
      </div>
      <div class="field" style="grid-column:1 / -1">
        <label>Note</label>
        <textarea id="note" placeholder="optional — brand, store, anything to remember" rows="1" maxlength="500"></textarea>
      </div>
      <button class="add-btn" type="submit">Add</button>
    </div>
  </form>

  <div class="chips" id="chips"></div>

  <div class="section-head">
    <h2 id="todoHeader">To get</h2>
  </div>
  <ul class="list" id="todoList"></ul>

  <div class="section-head" id="doneHead" style="display:none">
    <h2>Got it</h2>
  </div>
  <ul class="list" id="doneList"></ul>

  <div class="footer-note" id="footerNote" style="display:none">
    <button class="clear" id="clearDone">Clear completed</button>
  </div>
</div>

<div class="status" id="status">saved</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {
  getDatabase, ref, onValue, push, update, remove, serverTimestamp, onDisconnect, goOnline
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyBiPZFbkyoXzkLVTZK0d90rbm34fjMsOVU",
  authDomain: "our-week-a1e41.firebaseapp.com",
  databaseURL: "https://our-week-a1e41-default-rtdb.firebaseio.com/",
  projectId: "our-week-a1e41",
  storageBucket: "our-week-a1e41.firebasestorage.app",
  messagingSenderId: "869005838010",
  appId: "1:869005838010:web:5fb2ded53f537581cba483"
};

const app = initializeApp(firebaseConfig);
const db  = getDatabase(app);
const listRef = ref(db, "ourList/items"); // <-- separate path from your planner

// ---------- State ----------
let items = {};          // id -> item
let activeCat = "All";
let editingId = null;

// ---------- DOM ----------
const $ = sel => document.querySelector(sel);
const todoListEl = $("#todoList");
const doneListEl = $("#doneList");
const doneHead   = $("#doneHead");
const chipsEl    = $("#chips");
const footerNote = $("#footerNote");
const statusEl   = $("#status");
const connDot    = $("#conn");
const connText   = $("#connText");

// ---------- Connection indicator ----------
const connRef = ref(db, ".info/connected");
onValue(connRef, snap => {
  const ok = snap.val() === true;
  connDot.classList.toggle("online", ok);
  connText.textContent = ok ? "live" : "offline";
});

// ---------- Live data ----------
onValue(listRef, snap => {
  items = snap.val() || {};
  render();
});

// ---------- Add ----------
$("#addForm").addEventListener("submit", e => {
  e.preventDefault();
  const title = $("#title").value.trim();
  if (!title) return;
  const qty = $("#qty").value.trim();
  const category = $("#category").value;
  const note = $("#note").value.trim();
  push(listRef, {
    title, qty, category, note,
    done: false,
    createdAt: serverTimestamp(),
  });
  e.target.reset();
  $("#category").value = category; // keep last category selected
  $("#title").focus();
  flash("added");
});

// ---------- Render ----------
function render(){
  const all = Object.entries(items).map(([id, v]) => ({ id, ...v }));
  // category chips
  const counts = {All: 0};
  for (const it of all){
    if (it.done) continue;
    counts.All++;
    counts[it.category] = (counts[it.category] || 0) + 1;
  }
  const cats = ["All", ...Object.keys(counts).filter(c => c !== "All").sort()];
  chipsEl.innerHTML = cats.map(c => `
    <button class="chip ${c===activeCat?'active':''}" data-cat="${escapeAttr(c)}">
      ${escapeHtml(c)}<span class="count">${counts[c]||0}</span>
    </button>
  `).join("");
  chipsEl.querySelectorAll(".chip").forEach(b => {
    b.onclick = () => { activeCat = b.dataset.cat; render(); };
  });

  const visible = all.filter(it => activeCat === "All" || it.category === activeCat);
  const todo = visible.filter(it => !it.done)
    .sort((a,b)=>(a.createdAt||0)-(b.createdAt||0));
  const done = visible.filter(it => it.done)
    .sort((a,b)=>(b.doneAt||0)-(a.doneAt||0));

  todoListEl.innerHTML = todo.length
    ? todo.map(renderItem).join("")
    : `<div class="empty">${activeCat === "All" ? "Nothing on the list. ✶" : "Nothing in " + escapeHtml(activeCat) + "."}</div>`;
  doneListEl.innerHTML = done.map(renderItem).join("");
  doneHead.style.display = done.length ? "flex" : "none";
  footerNote.style.display = done.length ? "block" : "none";
  bindItemEvents();
}

function renderItem(it){
  if (editingId === it.id) return renderEdit(it);
  const meta = [];
  if (it.qty) meta.push(`<span>×${escapeHtml(it.qty)}</span>`);
  if (it.category) meta.push(`<span class="cat">${escapeHtml(it.category)}</span>`);
  return `
    <li class="item ${it.done ? 'done':''}" data-id="${it.id}">
      <input class="check" type="checkbox" ${it.done?'checked':''} aria-label="Mark done"/>
      <div class="item-body">
        <div class="item-title">${escapeHtml(it.title || '')}</div>
        ${meta.length ? `<div class="item-meta">${meta.join('')}</div>`:''}
        ${it.note ? `<div class="item-note">${escapeHtml(it.note)}</div>`:''}
      </div>
      <div class="actions">
        <button class="icon-btn" data-action="edit" aria-label="Edit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </button>
        <button class="icon-btn danger" data-action="delete" aria-label="Delete">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
        </button>
      </div>
    </li>
  `;
}

function renderEdit(it){
  const cats = ["Groceries","Household","Pharmacy","Gifts","Home","Clothing","Tech","Other"];
  const opts = cats.map(c => `<option ${c===it.category?'selected':''}>${c}</option>`).join("");
  return `
    <li class="item" data-id="${it.id}">
      <input class="check" type="checkbox" ${it.done?'checked':''} aria-label="Mark done"/>
      <div class="item-body" style="grid-column:2 / -1">
        <form class="edit-form" data-edit-id="${it.id}">
          <div class="field" style="grid-column:1 / -1">
            <label>Item</label>
            <input name="title" value="${escapeAttr(it.title||'')}" required maxlength="200"/>
          </div>
          <div class="field">
            <label>Qty</label>
            <input name="qty" value="${escapeAttr(it.qty||'')}" maxlength="20"/>
          </div>
          <div class="field">
            <label>Category</label>
            <select name="category">${opts}</select>
          </div>
          <div class="field" style="grid-column:1 / -1">
            <label>Note</label>
            <textarea name="note" rows="2" maxlength="500">${escapeHtml(it.note||'')}</textarea>
          </div>
          <div class="edit-actions">
            <button type="button" class="ghost-btn" data-action="cancel">Cancel</button>
            <button type="submit" class="ghost-btn primary">Save</button>
          </div>
        </form>
      </div>
    </li>
  `;
}

function bindItemEvents(){
  document.querySelectorAll("li.item").forEach(li => {
    const id = li.dataset.id;
    const check = li.querySelector(".check");
    if (check) check.onchange = () => {
      update(ref(db, `ourList/items/${id}`), {
        done: check.checked,
        doneAt: check.checked ? serverTimestamp() : null,
      });
      flash(check.checked ? "got it" : "back on list");
    };
    li.querySelectorAll("[data-action]").forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const a = btn.dataset.action;
        if (a === "delete"){
          if (confirm("Delete this item?")){
            remove(ref(db, `ourList/items/${id}`));
            flash("deleted");
          }
        } else if (a === "edit"){
          editingId = id; render();
        } else if (a === "cancel"){
          editingId = null; render();
        }
      };
    });
    const form = li.querySelector("form.edit-form");
    if (form){
      form.onsubmit = (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const patch = {
          title: (fd.get("title")||"").toString().trim(),
          qty:   (fd.get("qty")||"").toString().trim(),
          category: (fd.get("category")||"Other").toString(),
          note:  (fd.get("note")||"").toString().trim(),
        };
        if (!patch.title) return;
        update(ref(db, `ourList/items/${id}`), patch);
        editingId = null;
        flash("saved");
      };
    }
  });
}

$("#clearDone").addEventListener("click", () => {
  const done = Object.entries(items).filter(([,v]) => v.done);
  if (!done.length) return;
  if (!confirm(`Clear ${done.length} completed item${done.length>1?'s':''}?`)) return;
  const updates = {};
  done.forEach(([id]) => { updates[`ourList/items/${id}`] = null; });
  update(ref(db), updates);
  flash("cleared");
});

// ---------- Utils ----------
let statusTimer;
function flash(msg){
  statusEl.textContent = msg;
  statusEl.classList.add("show");
  clearTimeout(statusTimer);
  statusTimer = setTimeout(()=>statusEl.classList.remove("show"), 1100);
}
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
}
function escapeAttr(s){ return escapeHtml(s); }
</script>
</body>
</html>
